{
  "realm": "poc",
  "displayName": "KrakenD POC",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "krakend-demo",
      "name": "KrakenD demo service client",
      "description": "Machine-to-machine client used to call the protected gateway endpoint",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "krakend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "krakend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}

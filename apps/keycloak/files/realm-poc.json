{
  "realm": "poc",
  "displayName": "KrakenD POC",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "krakend-demo",
      "name": "KrakenD demo service client",
      "description": "Machine-to-machine client used to call the protected gateway endpoint",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "krakend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "krakend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "krakend-browser",
      "name": "Browser login demo",
      "description": "Public client for the authorization-code + PKCE flow used by the login page at http://api.localhost:8080/login",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://api.localhost:8080/*"
      ],
      "webOrigins": [
        "http://api.localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://api.localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "krakend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "krakend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}

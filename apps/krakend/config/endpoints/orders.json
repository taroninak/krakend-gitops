[
  {
    "@comment": "An order with its customer and the participants of all its events in one list. Calls run in order: 0 the order; 1 its customer ({resp0_customer_id}); 2 the order's events, whose participant_ids pluck collects into one list; 3 those users in one batch call ({resp2_participant_ids}). Repeated ids are harmless: /users?ids= returns each matching user once.",
    "endpoint": "/v1/orders/{id}",
    "method": "GET",
    "output_encoding": "json",
    "extra_config": {
      "auth/validator": {
        "@comment": "Who is calling decides the rate-limit bucket: the token's organization_id claim is copied into the X-Organization-Id header, which the limiter below counts on.",
        "alg": "RS256",
        "jwk_url": "http://keycloak-keycloakx-http.iam.svc.cluster.local/realms/poc/protocol/openid-connect/certs",
        "issuer": "http://keycloak.localhost:8080/realms/poc",
        "audience": [
          "krakend"
        ],
        "cookie_key": "access_token",
        "cache": true,
        "cache_duration": 900,
        "disable_jwk_security": true,
        "propagate_claims": [
          [
            "organization_id",
            "X-Organization-Id"
          ]
        ]
      },
      "qos/ratelimit/router": {
        "@comment": "10 requests a minute per organization, shared by every user and client in it. Counters live in each KrakenD instance's memory, so with 2 replicas an organization gets up to 20 a minute. client_capacity is set explicitly: on 3.0.0 it did not default to client_max_rate as documented, and the bucket held a single request.",
        "client_max_rate": 10,
        "client_capacity": 10,
        "every": "1m",
        "strategy": "header",
        "key": "X-Organization-Id"
      },
      "proxy": {
        "sequential": true,
        "flatmap_filter": [
          {
            "type": "del",
            "args": [
              "participant_ids"
            ]
          },
          {
            "type": "del",
            "args": [
              "events.*.participant_ids"
            ]
          },
          {
            "type": "del",
            "args": [
              "events.*.order_id"
            ]
          },
          {
            "type": "del",
            "args": [
              "requested"
            ]
          },
          {
            "type": "del",
            "args": [
              "returned"
            ]
          }
        ]
      }
    },
    "backend": [
      {
        "url_pattern": "/orders/{id}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/users/{resp0_customer_id}",
        "encoding": "json",
        "group": "customer",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/events?order_id={id}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ],
        "extra_config": {
          "modifier/lua-backend": {
            "sources": [
              "/etc/krakend/collections.lua"
            ],
            "post": "pluck(response.load(), 'events', 'participant_ids', 'participant_ids')",
            "allow_open_libs": false
          }
        }
      },
      {
        "url_pattern": "/users?ids={resp2_participant_ids}",
        "encoding": "json",
        "mapping": {
          "customers": "participants",
          "missing": "participants_missing"
        },
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  }
]

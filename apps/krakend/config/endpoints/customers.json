[
  {
    "endpoint": "/v1/users/{id}",
    "method": "GET",
    "output_encoding": "json",
    "backend": [
      {
        "url_pattern": "/users/{id}",
        "encoding": "json",
        "host": [
          "http://users-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  },
  {
    "endpoint": "/v1/orders/{id}",
    "method": "GET",
    "output_encoding": "json",
    "backend": [
      {
        "url_pattern": "/orders/{id}",
        "encoding": "json",
        "host": [
          "http://orders-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  },
  {
    "endpoint": "/v1/customers/{id}",
    "method": "GET",
    "output_encoding": "json",
    "backend": [
      {
        "url_pattern": "/users/{id}",
        "encoding": "json",
        "host": [
          "http://users-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/orders/{id}",
        "encoding": "json",
        "host": [
          "http://orders-api.demo.svc.cluster.local:8080"
        ]
      }
    ],
    "extra_config": {
      "auth/validator": {
        "@comment": "Accepts the token from the Authorization header or, for browser navigation, from the cookie the login page sets.",
        "alg": "RS256",
        "jwk_url": "http://keycloak-keycloakx-http.iam.svc.cluster.local/realms/poc/protocol/openid-connect/certs",
        "issuer": "http://keycloak.localhost:8080/realms/poc",
        "audience": [
          "krakend"
        ],
        "cookie_key": "access_token",
        "cache": true,
        "cache_duration": 900,
        "disable_jwk_security": true
      }
    }
  },
  {
    "@comment": "Fan-out driven by a response body: backend 0 returns the ids, and each following backend substitutes one of them into its path via {resp0_ids.*}. Two rules that cost an afternoon to find: backend 0 must NOT declare a `group` (a group nests its data out of reach of resp0_*), and the flatmap target must already hold a list (backend 0 seeds `customers: []`) or the moves build an object keyed \"0\",\"1\",\"2\" instead of an array.",
    "endpoint": "/v1/customers",
    "method": "GET",
    "output_encoding": "json",
    "extra_config": {
      "proxy": {
        "sequential": true,
        "flatmap_filter": [
          {
            "type": "move",
            "args": [
              "customer_1",
              "customers.0"
            ]
          },
          {
            "type": "move",
            "args": [
              "customer_2",
              "customers.1"
            ]
          },
          {
            "type": "move",
            "args": [
              "customer_3",
              "customers.2"
            ]
          },
          {
            "type": "del",
            "args": [
              "segment"
            ]
          },
          {
            "type": "del",
            "args": [
              "count"
            ]
          },
          {
            "type": "del",
            "args": [
              "ids"
            ]
          }
        ]
      }
    },
    "backend": [
      {
        "url_pattern": "/customer-ids",
        "encoding": "json",
        "host": [
          "http://users-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/users/{resp0_ids.first}",
        "encoding": "json",
        "group": "customer_1",
        "host": [
          "http://users-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/users/{resp0_ids.second}",
        "encoding": "json",
        "group": "customer_2",
        "host": [
          "http://users-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/users/{resp0_ids.third}",
        "encoding": "json",
        "group": "customer_3",
        "host": [
          "http://users-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  },
  {
    "@comment": "The other merge style: each backend declares a `group`, so its response stays nested under that name instead of being flattened alongside the other. Compare with /v1/customers/{id}.",
    "endpoint": "/v1/profile/{id}",
    "method": "GET",
    "output_encoding": "json",
    "extra_config": {
      "qos/ratelimit/router": {
        "max_rate": 20,
        "capacity": 20
      }
    },
    "backend": [
      {
        "url_pattern": "/users/{id}",
        "encoding": "json",
        "group": "identity",
        "host": [
          "http://users-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/orders/{id}",
        "encoding": "json",
        "group": "purchases",
        "host": [
          "http://orders-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  }
]

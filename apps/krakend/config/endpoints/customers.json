[
  {
    "endpoint": "/v1/users/{id}",
    "method": "GET",
    "output_encoding": "json",
    "backend": [
      {
        "url_pattern": "/users/{id}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  },
  {
    "endpoint": "/v1/orders/{id}",
    "method": "GET",
    "output_encoding": "json",
    "backend": [
      {
        "url_pattern": "/orders/{id}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  },
  {
    "endpoint": "/v1/customers/{id}",
    "method": "GET",
    "output_encoding": "json",
    "backend": [
      {
        "url_pattern": "/users/{id}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/orders/{id}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      }
    ],
    "extra_config": {
      "auth/validator": {
        "@comment": "Accepts the token from the Authorization header or, for browser navigation, from the cookie the login page sets.",
        "alg": "RS256",
        "jwk_url": "http://keycloak-keycloakx-http.iam.svc.cluster.local/realms/poc/protocol/openid-connect/certs",
        "issuer": "http://keycloak.localhost:8080/realms/poc",
        "audience": [
          "krakend"
        ],
        "cookie_key": "access_token",
        "cache": true,
        "cache_duration": 900,
        "disable_jwk_security": true
      }
    }
  },
  {
    "@comment": "Two calls, any number of customers: backend 0 returns the id list, and backend 1 passes all of it to the batch endpoint in one request. A whole array substituted into {resp0_ids} is rendered comma-joined by KrakenD 2.9 \u2014 observed behaviour, not documented, so `make smoke` asserts the result size to catch a change on upgrade.",
    "endpoint": "/v1/customers",
    "method": "GET",
    "output_encoding": "json",
    "extra_config": {
      "proxy": {
        "sequential": true,
        "flatmap_filter": [
          {
            "type": "del",
            "args": [
              "segment"
            ]
          },
          {
            "type": "del",
            "args": [
              "count"
            ]
          },
          {
            "type": "del",
            "args": [
              "ids"
            ]
          },
          {
            "type": "del",
            "args": [
              "requested"
            ]
          },
          {
            "type": "del",
            "args": [
              "returned"
            ]
          }
        ]
      }
    },
    "backend": [
      {
        "url_pattern": "/customer-ids",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/users?ids={resp0_ids}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  },
  {
    "@comment": "The other merge style: each backend declares a `group`, so its response stays nested under that name instead of being flattened alongside the other. Compare with /v1/customers/{id}.",
    "endpoint": "/v1/profile/{id}",
    "method": "GET",
    "output_encoding": "json",
    "extra_config": {
      "qos/ratelimit/router": {
        "max_rate": 20,
        "capacity": 20
      }
    },
    "backend": [
      {
        "url_pattern": "/users/{id}",
        "encoding": "json",
        "group": "identity",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/orders/{id}",
        "encoding": "json",
        "group": "purchases",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  }
]

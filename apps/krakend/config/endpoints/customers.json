[
  {
    "endpoint": "/v1/users/{id}",
    "method": "GET",
    "output_encoding": "json",
    "backend": [
      {
        "url_pattern": "/users/{id}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  },
  {
    "@comment": "A customer's orders, each with its own participants. Three calls whatever the number of orders: 0 the orders; 1 the events of all of them; 2 every participant in one batch. Attaching participants to each order is a loop, which KrakenD config cannot express, so three small functions in lua/customer-orders.lua do the looping \u2014 collect the order ids after call 0, the participant ids after call 1, and attach each order's users at the end.",
    "endpoint": "/v1/customers/{id}/orders",
    "method": "GET",
    "output_encoding": "json",
    "extra_config": {
      "proxy": {
        "sequential": true
      },
      "modifier/lua-proxy": {
        "sources": [
          "/etc/krakend/customer-orders.lua"
        ],
        "post": "attach_participants(response.load())",
        "allow_open_libs": false
      }
    },
    "backend": [
      {
        "url_pattern": "/customers/{id}/orders",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ],
        "extra_config": {
          "modifier/lua-backend": {
            "sources": [
              "/etc/krakend/customer-orders.lua"
            ],
            "post": "collect_order_ids(response.load())",
            "allow_open_libs": false
          }
        }
      },
      {
        "url_pattern": "/events?order_id={resp0_order_ids}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ],
        "extra_config": {
          "modifier/lua-backend": {
            "sources": [
              "/etc/krakend/customer-orders.lua"
            ],
            "post": "collect_participant_ids(response.load())",
            "allow_open_libs": false
          }
        }
      },
      {
        "url_pattern": "/users?ids={resp1_participant_ids}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  },
  {
    "endpoint": "/v1/customers/{id}",
    "method": "GET",
    "output_encoding": "json",
    "backend": [
      {
        "url_pattern": "/users/{id}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/customers/{id}/orders",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      }
    ],
    "extra_config": {
      "auth/validator": {
        "@comment": "Accepts the token from the Authorization header or, for browser navigation, from the cookie the login page sets.",
        "alg": "RS256",
        "jwk_url": "http://keycloak-keycloakx-http.iam.svc.cluster.local/realms/poc/protocol/openid-connect/certs",
        "issuer": "http://keycloak.localhost:8080/realms/poc",
        "audience": [
          "krakend"
        ],
        "cookie_key": "access_token",
        "cache": true,
        "cache_duration": 900,
        "disable_jwk_security": true
      }
    }
  },
  {
    "@comment": "Two calls, any number of customers: backend 0 returns the id list, and backend 1 passes all of it to the batch endpoint in one request. A whole array substituted into {resp0_ids} is rendered comma-joined by KrakenD 2.9 \u2014 observed behaviour, not documented, so `make smoke` asserts the result size to catch a change on upgrade.",
    "endpoint": "/v1/customers",
    "method": "GET",
    "output_encoding": "json",
    "extra_config": {
      "proxy": {
        "sequential": true,
        "flatmap_filter": [
          {
            "type": "del",
            "args": [
              "segment"
            ]
          },
          {
            "type": "del",
            "args": [
              "count"
            ]
          },
          {
            "type": "del",
            "args": [
              "ids"
            ]
          },
          {
            "type": "del",
            "args": [
              "requested"
            ]
          },
          {
            "type": "del",
            "args": [
              "returned"
            ]
          }
        ]
      }
    },
    "backend": [
      {
        "url_pattern": "/customer-ids",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/users?ids={resp0_ids}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  },
  {
    "@comment": "The other merge style: each backend declares a `group`, so its response stays nested under that name instead of being flattened alongside the other. Compare with /v1/customers/{id}.",
    "endpoint": "/v1/profile/{id}",
    "method": "GET",
    "output_encoding": "json",
    "extra_config": {
      "qos/ratelimit/router": {
        "max_rate": 20,
        "capacity": 20
      }
    },
    "backend": [
      {
        "url_pattern": "/users/{id}",
        "encoding": "json",
        "group": "identity",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/customers/{id}/orders",
        "encoding": "json",
        "group": "purchases",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  }
]

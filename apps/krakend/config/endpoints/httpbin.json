[
  {
    "endpoint": "/v1/uuid",
    "method": "GET",
    "output_encoding": "json",
    "input_headers": [
      "Content-Type",
      "X-Request-Id"
    ],
    "backend": [
      {
        "url_pattern": "/uuid",
        "encoding": "json",
        "host": [
          "http://httpbin.demo.svc.cluster.local:8080"
        ]
      }
    ]
  },
  {
    "endpoint": "/v1/status/{code}",
    "method": "GET",
    "output_encoding": "no-op",
    "backend": [
      {
        "url_pattern": "/status/{code}",
        "encoding": "no-op",
        "host": [
          "http://httpbin.demo.svc.cluster.local:8080"
        ]
      }
    ]
  },
  {
    "endpoint": "/v1/profile",
    "method": "GET",
    "output_encoding": "json",
    "extra_config": {
      "qos/ratelimit/router": {
        "max_rate": 20,
        "capacity": 20
      }
    },
    "backend": [
      {
        "url_pattern": "/uuid",
        "encoding": "json",
        "group": "identity",
        "host": [
          "http://httpbin.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/headers",
        "encoding": "json",
        "group": "request",
        "host": [
          "http://httpbin.demo.svc.cluster.local:8080"
        ]
      }
    ]
  }
]

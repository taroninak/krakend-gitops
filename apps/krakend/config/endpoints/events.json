[
  {
    "@comment": "An event, its participants, and its customer \u2014 found through the event's order. Calls run in order: 0 the event; 1 the order named by the event's order_id; 2 the customer named by the order's customer_id ({resp1_...}: a value from call 1, not call 0); 3 every participant in one batch call. Calls 0 and 1 have no `group` because later calls read their values, and a group would nest those values out of reach \u2014 so the order's own fields land at the top level and flatmap removes them.",
    "endpoint": "/v1/events/{id}",
    "method": "GET",
    "output_encoding": "json",
    "extra_config": {
      "proxy": {
        "sequential": true,
        "flatmap_filter": [
          {
            "type": "del",
            "args": [
              "participant_ids"
            ]
          },
          {
            "type": "del",
            "args": [
              "id"
            ]
          },
          {
            "type": "del",
            "args": [
              "customer_id"
            ]
          },
          {
            "type": "del",
            "args": [
              "item"
            ]
          },
          {
            "type": "del",
            "args": [
              "total"
            ]
          },
          {
            "type": "del",
            "args": [
              "requested"
            ]
          },
          {
            "type": "del",
            "args": [
              "returned"
            ]
          }
        ]
      }
    },
    "backend": [
      {
        "url_pattern": "/events/{id}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/orders/{resp0_order_id}",
        "encoding": "json",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/users/{resp1_customer_id}",
        "encoding": "json",
        "group": "customer",
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/users?ids={resp0_participant_ids}",
        "encoding": "json",
        "mapping": {
          "customers": "participants",
          "missing": "participants_missing"
        },
        "host": [
          "http://demo-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  }
]

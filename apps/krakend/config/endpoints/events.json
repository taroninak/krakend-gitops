[
  {
    "@comment": "One event, two lists of people. events-api returns participant_ids and customer_ids; each list is resolved against users-api in a single batch call. Both batch responses name their array `customers`, so `mapping` renames it on the participants call \u2014 without that the two would collide on merge and only one list would survive. `missing` is renamed per list for the same reason, so an unknown id is reported against the list it came from.",
    "endpoint": "/v1/events/{id}",
    "method": "GET",
    "output_encoding": "json",
    "extra_config": {
      "proxy": {
        "sequential": true,
        "flatmap_filter": [
          {
            "type": "del",
            "args": [
              "participant_ids"
            ]
          },
          {
            "type": "del",
            "args": [
              "customer_ids"
            ]
          },
          {
            "type": "del",
            "args": [
              "requested"
            ]
          },
          {
            "type": "del",
            "args": [
              "returned"
            ]
          }
        ]
      }
    },
    "backend": [
      {
        "url_pattern": "/events/{id}",
        "encoding": "json",
        "host": [
          "http://events-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/users?ids={resp0_participant_ids}",
        "encoding": "json",
        "mapping": {
          "customers": "participants",
          "missing": "participants_missing"
        },
        "host": [
          "http://users-api.demo.svc.cluster.local:8080"
        ]
      },
      {
        "url_pattern": "/users?ids={resp0_customer_ids}",
        "encoding": "json",
        "mapping": {
          "missing": "customers_missing"
        },
        "host": [
          "http://users-api.demo.svc.cluster.local:8080"
        ]
      }
    ]
  }
]
